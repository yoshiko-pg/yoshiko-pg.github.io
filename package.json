{
  "name": "yoshiko-pg.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx script/prerender.ts",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "pnpm run build && gh-pages -d dist",
    "lint": "eslint src script --ext .ts,.tsx",
    "format": "prettier --write \"{src,script}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,script}/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test run --passWithNoTests",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.1",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lefthook": "^2.1.9",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.4",
    "tsx": "^4.22.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
